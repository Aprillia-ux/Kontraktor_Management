
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isMandor() {
      return signedIn() && userRole() == 'mandor';
    }

    function isKeuangan() {
      return signedIn() && userRole() == 'keuangan';
    }

    function isApproved() {
      return isAdmin() || isMandor() || isKeuangan();
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'createdAt'
        ])
        && request.resource.data.role == 'pending'
        && request.resource.data.email == request.auth.token.email;

      allow update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isApproved();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'client', 'location', 'contractValue',
          'startDate', 'endDate', 'status', 'createdBy', 'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.contractValue is number
        && request.resource.data.contractValue >= 0;

      allow update, delete: if isAdmin();

      match /progress/{progressId} {
        allow read: if isApproved();

        allow create: if (isAdmin() || isMandor())
          && request.resource.data.keys().hasOnly([
            'note', 'createdBy', 'createdAt'
          ])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 1000;

        allow update, delete: if isAdmin();
      }
    }

    match /expenses/{expenseId} {
      allow read: if isApproved();

      allow create: if (isAdmin() || isKeuangan())
        && request.resource.data.keys().hasOnly([
          'projectId', 'category', 'note', 'amount',
          'date', 'createdBy', 'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow update, delete: if isAdmin();
    }
  }
}
